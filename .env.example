APP_ENV=local
LOG_LEVEL=INFO
PROVIDER_MODE=build        # build = Cloudflare only | test = paid providers
SPEND_CAP_USD=2            # max spend per test session in test mode

# Free providers
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=

# Paid providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAL_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=          # Jev (leave empty -> LLM fallback)
GOOGLE_API_KEY=            # fallback
OPENAI_API_KEY=            # fallback
SILICONFLOW_API_KEY=       # optional

# Image create (execution-steps/Image Create Agent/TXT2IMG-AGENT-SPEC.md)
OPENROUTER_IMAGES=false    # true = OpenRouter image models join the chain. PAID. Only when asked
STREAM_TOKEN_SECRET=        # signs the ?t= tokens on /events and image URLs. Empty = temporary (dev only)
FAL_IMAGES=false           # true = fal image models join the chain. PAID. Only when asked
COMPILE_MODE=llm           # llm = the enhancer writes the final prompt | code = from the brief
PROMPT_SOURCE=hub          # hub = pull prompts from LangSmith Hub (falls back to prompts/create/txt2img/)
ENHANCER_MAX_TOKENS=350
# LANGSMITH_PROJECT and PROMPT_HUB_TAG default to dev, or prod when APP_ENV=prod

# Memory
PINECONE_API_KEY=
PINECONE_INDEX=media-engine-dev

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=media-engine-dev   # leave empty for app-dev / app-prod by APP_ENV

# Local dev
LOCAL_OUTPUT_DIR=./outputs
CHECKPOINT_DB=./.checkpoints.sqlite
