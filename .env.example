# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=media-engine-dev

# Local dev
LOCAL_OUTPUT_DIR=./outputs
CHECKPOINT_DB=./.checkpoints.sqlite
