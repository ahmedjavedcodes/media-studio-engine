APP_ENV=local
LOG_LEVEL=INFO

# Free providers
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=

# Paid providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAL_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=          # Jev (leave empty -> LLM fallback)
GOOGLE_API_KEY=            # fallback
OPENAI_API_KEY=            # fallback
SILICONFLOW_API_KEY=       # optional

# Memory
PINECONE_API_KEY=
