# 1 (the default) replays scripted events and placeholder images: no backend needed.
# Set to 0 to talk to the API in NEXT_PUBLIC_API_URL (see project-status/ARCHITECTURE.md, section 8).
NEXT_PUBLIC_MOCK=1
NEXT_PUBLIC_API_URL=http://localhost:8000

# Developer inspector: shows every step, model call, decision and the budget for a run.
# Needs the API started with DEBUG_TRACE=1 and NEXT_PUBLIC_MOCK=0. Off by default.
NEXT_PUBLIC_INSPECTOR=0
